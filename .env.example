# Copy this file to .env and fill in your keys
# cp .env.example .env

OPENROUTER_API_KEY=your_openrouter_key_here
OPENAI_API_KEY=your_openai_key_here

# API key to protect your journal when exposed on local network
# Set any random string — the iOS app will send this in the X-API-Key header
JOURNAL_API_KEY=change_me_to_something_random

# Port the server listens on
PORT=5050
