# Your private journal data never goes into git.
data/entries/*.json
data/media/*
!data/entries/.gitkeep
!data/media/.gitkeep

.DS_Store
node_modules/
.env
data/journal.db
data/journal.db-wal
data/journal.db-shm

# iOS — the Xcode project + Info.plist are generated from ios/project.yml
# (`xcodegen generate`)
ios/*.xcodeproj
ios/VoiceJournal/Info.plist
ios/.build/
ios/DerivedData/
xcuserdata/
